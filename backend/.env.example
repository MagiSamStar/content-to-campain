# AI provider: ollama locally, openai in production
AI_PROVIDER=ollama

# OpenAI — leave the key blank in this example file
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
RATE_LIMIT_GENERATE_WINDOW_SECONDS=86400
RATE_LIMIT_GENERATE_PER_WINDOW=3
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_PER_WINDOW=20
OLLAMA_MODEL=gemma4:e4b

#SENT
SENT_DM_API_KEY=your_sandbox_key_here
SENT_TEMPLATE_ID=a13774f5-2313-4c59-837c-a26fabbb12b0
SENT_TEST_PHONE=+15555555555
